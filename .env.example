# ─── Django ─────────────────────────────────────────────────────
DJANGO_SECRET_KEY=change-me-locally-and-set-real-value-via-secret-mgmt
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=lunch.intern.mader.eu,localhost,127.0.0.1
DJANGO_TIME_ZONE=Europe/Berlin
DJANGO_LANGUAGE_CODE=de-de

# Hinter Forti-VIP (TLS-Offload). In reinem Dev-HTTP-Setup auf False stellen.
DJANGO_BEHIND_TLS_PROXY=True

# ─── Datenbank ──────────────────────────────────────────────────
POSTGRES_DB=maderlunch
POSTGRES_USER=maderlunch
POSTGRES_PASSWORD=change-me-locally
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ─── Entra / OIDC (Phase 2 — leer lassen, solange deaktiviert) ──
OIDC_ENABLED=False
OIDC_RP_CLIENT_ID=
OIDC_RP_CLIENT_SECRET=
OIDC_TENANT_ID=
OIDC_REDIRECT_URI=https://lunch.intern.mader.eu/oidc/callback/

# ─── Audit / Logging ────────────────────────────────────────────
DJANGO_LOG_LEVEL=INFO
