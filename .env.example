# MaderLunch — Umgebungs-Variablen (Vorlage)
# In .env kopieren und ausfüllen. .env NIEMALS committen.

# ----- Django Core -----
DJANGO_SECRET_KEY=__CHANGE_ME__django_secret_50_chars_random__
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=lunch.mader.eu,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://lunch.mader.eu

# HSTS-Sekunden — Dev/Erstinbetriebnahme: 3600 (1h). Nach 1-2 Wochen Stabilität: 31536000 (1 Jahr).
DJANGO_HSTS_SECONDS=3600

# ----- PostgreSQL -----
POSTGRES_DB=maderlunch
POSTGRES_USER=maderlunch
POSTGRES_PASSWORD=__CHANGE_ME__strong_db_password__
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ----- Entra (Microsoft) -----
# Werte aus der App-Registrierung in entra.microsoft.com
# - TENANT_ID: Directory (tenant) ID, GUID
# - CLIENT_ID: Application (client) ID, GUID
# - CLIENT_SECRET: Value des Client Secrets (NICHT die Secret-ID!)
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_SECRET=__CHANGE_ME__from_entra_admin_center__
